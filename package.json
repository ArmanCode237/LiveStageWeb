{
  "name": "live-stage-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Sitio oficial de presentación del ecosistema Live Stage: instrumento virtual y OSC Live Stage.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build:offline": "node scripts/offline-build.cjs",
    "preview:offline": "node scripts/preview-offline.cjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
